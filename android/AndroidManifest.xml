<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.personal.babelslibrary"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- the News event check keeps its schedule after the phone restarts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- a video in the browser keeps playing with the screen off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- dictation into phone notes (asked for the first time you dictate) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- the quick panel's brightness slider for the whole phone (you allow it on Android's own page first) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Android 11+: lets the app see the phone's speech recognition service -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- the Add-ons tab lists the phone's other apps (only the ones you can open, like any home screen) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- the computer is reached by plain http on the home Wi-Fi (its sync server has no certificate);
         every request carries the phone's pairing token -->
    <application
        android:label="Babel's Library"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|screenLayout|smallestScreenSize|density"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- can be picked as the phone's home screen (the Bulletin, with your apps on the Add-ons tab) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- can be picked as the phone's browser: links from other apps open on the Browser tab -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- "Share → Babel's Library" in other apps: the file goes to the computer's library -->
            <intent-filter android:label="Add to Babel's Library">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-cbz" />
                <data android:mimeType="application/x-cbr" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/vnd.comicbook-rar" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
        <!-- a second app in the app list, "Babel Resume": opens the last thing you had open (for the side key's
             double press: Settings, Advanced features, Side key, Double press, Open app). A real screen of its own
             (not an alias), which hands over to the main one and closes -->
        <activity
            android:name=".Resume"
            android:label="Babel Resume"
            android:icon="@mipmap/ic_launcher"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- sends files to the computer in the background, with progress and Cancel in the notification shade -->
        <service
            android:name=".UploadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- keeps the browser's video playing after you leave it or turn the screen off -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- News: looks for new events now and then, and puts them in the notification shade -->
        <service
            android:name=".NewsAlerts"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- the home-screen widget: what you're reading now and this week's challenge -->
        <receiver
            android:name=".BabelWidget"
            android:exported="true"
            android:label="Babel's Library">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
        <!-- the sleep screen as Android's screen saver (while charging or docked) -->
        <service
            android:name=".SleepDream"
            android:exported="true"
            android:label="Babel's Library"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <!-- other apps' notifications in the quick panel (you switch it on: Settings, Notification access) -->
        <service
            android:name=".BabelNotifs"
            android:exported="true"
            android:label="Babel's Library"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- hands a downloaded file to another app (video player, comic reader) for formats this app can't show -->
        <provider
            android:name=".FilesProvider"
            android:authorities="com.personal.babelslibrary.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
