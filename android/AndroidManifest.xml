<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.personal.babelslibrary"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- the News event check keeps its schedule after the phone restarts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- a video in the browser keeps playing with the screen off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- dictation into phone notes (asked for the first time you dictate) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+: lets the app see the phone's speech recognition service -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- the computer is reached by plain http on the home Wi-Fi (its sync server has no certificate);
         every request carries the phone's pairing token -->
    <application
        android:label="Babel's Library"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|screenLayout|smallestScreenSize|density"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share → Babel's Library" in other apps: the file goes to the computer's library -->
            <intent-filter android:label="Add to Babel's Library">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-cbz" />
                <data android:mimeType="application/x-cbr" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/vnd.comicbook-rar" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
        <!-- sends files to the computer in the background, with progress and Cancel in the notification shade -->
        <service
            android:name=".UploadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- keeps the browser's video playing after you leave it or turn the screen off -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- News: looks for new events now and then, and puts them in the notification shade -->
        <service
            android:name=".NewsAlerts"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- hands a downloaded file to another app (video player, comic reader) for formats this app can't show -->
        <provider
            android:name=".FilesProvider"
            android:authorities="com.personal.babelslibrary.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
